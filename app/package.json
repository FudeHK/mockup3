{
  "name": "shopnavi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --test-concurrency=1 \"tests/unit/*.test.mjs\"",
    "db:local": "node tests/local/pg.mjs start",
    "test:rls": "node --test --test-concurrency=1 \"tests/rls/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "test": "npm run test:unit && npm run test:rls",
    "icons": "node scripts/make-icons.mjs",
    "test:e2e:v2": "node tests/e2e/v2.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  },
  "type": "module"
}
